{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wavetracer",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* 요청만 워커로 보내고, 그 외 정적 파일은 지금처럼 워커를 거치지 않고 바로 서빙된다.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
