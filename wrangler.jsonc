{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wavetracer",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* 요청만 워커로 보내고, 그 외 정적 파일은 지금처럼 워커를 거치지 않고 바로 서빙된다.
    "run_worker_first": ["/api/*"]
  },
  // 파도 제보(/api/reports) 저장용 D1 데이터베이스.
  // schema.sql 을 로컬/원격에 각각 적용해야 실제로 쓸 수 있다 (README 참고).
  "d1_databases": [
    { "binding": "DB", "database_name": "wavetracer", "database_id": "ebe8873b-639d-43aa-ab8f-b5ed0e2e1919" }
  ],
  "observability": {
    "enabled": true
  }
}
